  "audio": {
    "open-1": {
      "file": "assets/audio/open-1.mp3",
      "duration": 3.866,
      "id": "open-1",
      "vo": "স্পিকিতে স্বাগতম — আপনার স্টুডিও-মানের এআই ভয়েস জেনারেটর।"
    },
    "what-1": {
      "file": "assets/audio/what-1.mp3",
      "duration": 7.628,
      "id": "what-1",
      "vo": "স্পিকি ডট টিএনএক্সবিডি ডট টপ — কার্টেশিয়ার সোনিক মডেলের ওপর তৈরি, একটি ফ্রি, বহুভাষিক টেক্সট-টু-স্পিচ প্ল্যাটফর্ম।"
    },
    "what-2": {
      "file": "assets/audio/what-2.mp3",
      "duration": 4.911,
      "id": "what-2",
      "vo": "কোনো সাইনআপ নেই, কোনো এপিআই কি নেই — শুধু সেকেন্ডের মধ্যে পেশাদার অডিও।"
    },
    "agenda-1": {
      "file": "assets/audio/agenda-1.mp3",
      "duration": 7.157,
      "id": "agenda-1",
      "vo": "আসুন, স্পিকির প্রতিটি ফিচার দেখে নেওয়া যাক — ভয়েস লাইব্রেরি থেকে ডেভেলপার এপিআই, আর টিএএস স্কিল পর্যন্ত।"
    },
    "lib-1": {
      "file": "assets/audio/lib-1.mp3",
      "duration": 1.959,
      "id": "lib-1",
      "vo": "প্রথমে, ভয়েস লাইব্রেরি।"
    },
    "lib-2": {
      "file": "assets/audio/lib-2.mp3",
      "duration": 4.754,
      "id": "lib-2",
      "vo": "বিয়াল্লিশটি ভাষা, আর আটশোরও বেশি কিউরেটেড ভয়েস — সব এক জায়গায়।"
    },
    "lang-1": {
      "file": "assets/audio/lang-1.mp3",
      "duration": 10.031,
      "id": "lang-1",
      "vo": "বাংলা, ইংরেজি, হিন্দি, স্প্যানিশ, ফ্রেঞ্চ, জার্মান, আরবি, জাপানি, কোরিয়ান, চাইনিজ — আরও অনেক ভাষা।"
    },
    "lang-2": {
      "file": "assets/audio/lang-2.mp3",
      "duration": 6.531,
      "id": "lang-2",
      "vo": "প্রতিটি ভাষায় রয়েছে পুরুষ ও মহিলা ভয়েস — নিউজ রিডার থেকে স্টোরিটেলার, অ্যাসিস্ট্যান্ট থেকে সিটি গাইড।"
    },
    "bn-1": {
      "file": "assets/audio/bn-1.mp3",
      "duration": 2.847,
      "id": "bn-1",
      "vo": "বাংলায় আছেন পূজা — এভারিডে অ্যাসিস্ট্যান্ট।"
    },
    "bn-2": {
      "file": "assets/audio/bn-2.mp3",
      "duration": 1.802,
      "id": "bn-2",
      "vo": "রুবেল — সিটি গাইড।"
    },
    "bn-3": {
      "file": "assets/audio/bn-3.mp3",
      "duration": 2.691,
      "id": "bn-3",
      "vo": "আর নিউজ রিডার — যিনি এই ভিডিওটি বলছেন।"
    },
    "en-1": {
      "file": "assets/audio/en-1.mp3",
      "duration": 2.429,
      "id": "en-1",
      "vo": "ইংরেজিতে রয়েছে প্রায় চারশো ভয়েস।"
    },
    "en-2a": {
      "file": "assets/audio/en-2a.mp3",
      "duration": 1.724,
      "id": "en-2a",
      "vo": "Ailsa — ওয়ার্ম গাইড।"
    },
    "en-2b": {
      "file": "assets/audio/en-2b.mp3",
      "duration": 2.351,
      "id": "en-2b",
      "vo": "Aarav — ওল্ড টাইম স্টোরিটেলার।"
    },
